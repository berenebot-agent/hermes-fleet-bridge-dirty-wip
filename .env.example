# Required. The chat must be a Telegram supergroup with Topics enabled.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_ALLOWED_USER_IDS=123456789

# Required. Existing Docker container names. Topic names are generated automatically.
HERMES_CONTAINERS=hermes-atlas,hermes-janus,hermes-hydra

# Optional
IDLE_TIMEOUT=15m
START_TIMEOUT=120s
RUN_TIMEOUT=60m
DATA_DIR=/data
# Default port 8642; key is taken automatically from each container's API_SERVER_KEY env.
HERMES_API_PORT=8642
# HERMES_API_KEY=only_if_not_in_container_environment
# HERMES_NETWORK=optional_network_name_to_prefer_if_multi_homed
