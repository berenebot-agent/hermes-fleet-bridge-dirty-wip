# Required. The chat must be a Telegram supergroup with Topics enabled.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_ALLOWED_USER_IDS=123456789

# Required. Fleet members identified by their compose project directory. The
# agent name (topic/state identity) is the directory's basename. Each directory
# must also be mounted into the bridge at the same absolute path in
# docker-compose.yml. Topic names are generated automatically.
HERMES_DIRS=/home/ben/projects/hermes-fleet-bridge/agents/redshirt-one,/home/ben/projects/hermes-fleet-bridge/agents/redshirt-two,/home/ben/projects/hermes-fleet-bridge/agents/redshirt-three

# Optional
IDLE_TIMEOUT=15m
START_TIMEOUT=120s
RUN_TIMEOUT=60m
DATA_DIR=/data
# Default Hermes API server port (8642); the bridge writes API_SERVER_* into each
# member's persistent data/.env, generating a strong key if none exists.
HERMES_API_PORT=8642
# HERMES_NETWORK=optional_network_name_to_prefer_if_multi_homed

# Optional. Pin specific topic icons (member=emoji, comma-separated). Members
# without an entry get a deterministic icon derived from their name. The emoji
# must be one Telegram allows as a topic icon (see getForumTopicIconStickers);
# an unknown emoji logs a warning and falls back to the derived icon.
# HERMES_ICONS=redshirt-one=🚀,redshirt-two=🎯

# Bridge container runtime user. Must match the host user that owns the member
# directories and repo/data (default 1000:1000); files the bridge writes (each
# member's data/.env, the state file) get this ownership, so the Hermes
# containers (HERMES_UID/GID) can read them.
# BRIDGE_UID=1000
# BRIDGE_GID=1000
# Host GID of the `docker` group (getent group docker) so the bridge can use the
# mounted /var/run/docker.sock while running unprivileged.
# DOCKER_GID=987
